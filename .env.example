# Copy to .env and fill in. Never commit the real .env.

# --- Target under test ---
BASE_URL=https://staging.deepcheck.example.com
API_BASE_URL=https://staging.deepcheck.example.com/api
TEST_ENV=staging

# --- Test credentials ---
TEST_USER=
TEST_PASSWORD=

# --- InfluxDB (test result sink) ---
# Leave INFLUX_URL empty to disable result reporting (e.g. local debugging).
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=local-dev-token
INFLUX_ORG=deepcheck
INFLUX_BUCKET=test_results

# --- CI metadata (auto-populated in CI; optional locally) ---
GIT_BRANCH=
GIT_COMMIT=
