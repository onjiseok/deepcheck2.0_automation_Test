# Copy to .env and fill in. Never commit the real .env.

# --- Target under test ---
BASE_URL=https://dev.deepcheck.deep-medi.com
API_BASE_URL=
TEST_ENV=dev

# --- Test accounts (by permission level) ---
# Shared password used for every level unless overridden per level.
TEST_PASSWORD=
TEST_USER_L1=
TEST_USER_L2=
TEST_USER_L3=
TEST_USER_L4=
# Optional per-level password overrides:
# TEST_PASSWORD_L1=

# --- InfluxDB (test result sink) ---
# Leave INFLUX_URL/TOKEN empty to disable result reporting (default for local runs).
# To send results, set these (docker-compose stack uses http://localhost:8086
# with token "local-dev-token").
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=deepcheck
INFLUX_BUCKET=test_results

# --- CI metadata (auto-populated in CI; optional locally) ---
GIT_BRANCH=
GIT_COMMIT=
